
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Quản lý kho hàng</title>

    @Styles.Render("~/Content/css")
    

    @Scripts.Render("~/bundles/modernizr")
</head>

<body>

    <!-- HEADER -->
    <header class="warehouse-header">
        <h2>WEBSITE QUẢN LÝ KHO HÀNG</h2>

        <div class="student-info">
            <span>
                Họ tên: Phạm Ngọc Phương Trinh
            </span>

            <span>
                MSSV: 25DH110586
            </span>
        </div>
    </header>

    <!-- MAIN LAYOUT -->
    <div class="warehouse-main">

        <!-- SIDEBAR -->
        <aside class="warehouse-sidebar">
            <h4>MENU CHỨC NĂNG</h4>

            @Html.ActionLink(
                "Câu 2 - Danh sách sản phẩm",
                "Index",
                "Products"
            )

            @Html.ActionLink(
                "Câu 3 - Lọc và sắp xếp",
                "Filter",
                "Products"
            )

            @Html.ActionLink(
                "Câu 4 - Điều chỉnh giá",
                "AdjustPrice",
                "Products"
            )

            @Html.ActionLink(
                "Câu 5 - Giảm giá hai sản phẩm",
                "DiscountTwo",
                "Products"
            )

            @Html.ActionLink(
                "Câu 6 - Thêm sản phẩm",
                "Create",
                "Products"
            )

            @Html.ActionLink(
                "Câu 7 - Thống kê",
                "Statistics",
                "Products"
            )
        </aside>

        <!-- CONTENT -->
        <main class="warehouse-content">
            @RenderBody()
        </main>

    </div>

    <!-- FOOTER -->
    <footer class="warehouse-footer">
        Ngày sinh: 11/07/2007
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>
</html>
