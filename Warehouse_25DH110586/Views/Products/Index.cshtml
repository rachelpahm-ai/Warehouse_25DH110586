
@model IEnumerable<Warehouse_25DH110586.Models.Products>

@{
    ViewBag.Title = "Danh sách sản phẩm";
}

<h2>Danh sách sản phẩm</h2>
<p>Thông tin sản phẩm đang có trong kho hàng.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<table class="table product-table">
    <thead>
        <tr>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th>Đơn giá</th>
            <th>Tồn kho</th>
            <th>Mức giá</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string level;
            string css;

            if (item.Price < 100000)
            {
                level = "Giá thấp";
                css = "price-low";
            }
            else if (item.Price < 500000)
            {
                level = "Giá trung bình";
                css = "price-medium";
            }
            else
            {
                level = "Giá cao";
                css = "price-high";
            }

            <tr>
                <td>@item.ProductName</td>
                <td>@item.Category</td>
                <td>@item.Price.ToString("N0") đ</td>
                <td>@item.Quantity</td>
                <td>
                    <span class="price-badge @css">
                        @level
                    </span>
                </td>
                <td>
                    @Html.ActionLink("Chỉnh sửa", "Edit",
                        new { id = item.ProductID },
                        new { @class = "btn btn-primary btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
