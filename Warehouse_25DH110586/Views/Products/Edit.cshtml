
@model Warehouse_25DH110586.Models.Products

@{
    ViewBag.Title = "Chỉnh sửa sản phẩm";
}

<div class="edit-card">
    <h2>Chỉnh sửa sản phẩm</h2>
    <p>Cập nhật thông tin sản phẩm trong kho.</p>

    @using (Html.BeginForm("Edit", "Products",
        new { id = Model.ProductID }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Tên sản phẩm</label>
            @Html.TextBoxFor(m => m.ProductName,
                new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.ProductName,
                "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Danh mục</label>
            @Html.TextBoxFor(m => m.Category,
                new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Category,
                "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Đơn giá (VNĐ)</label>
            @Html.TextBox("Price",
                Model.Price.ToString(
                    System.Globalization.CultureInfo.InvariantCulture),
                new
                     {
                    @class = "form-control",
                    type = "number",
                    step = "0.01"
                })
            @Html.ValidationMessage("Price",
                "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Số lượng tồn kho</label>
            <input type="number"
                   value="@Model.Quantity"
                   class="form-control"
                   disabled />
            <small class="text-muted">
                Không cho phép chỉnh sửa số lượng.
            </small>
        </div>

        <button type="submit" class="btn btn-primary">
            Lưu thay đổi
        </button>

        @Html.ActionLink("Quay lại", "Index", null,
            new { @class = "btn btn-default" })
    }
</div>
