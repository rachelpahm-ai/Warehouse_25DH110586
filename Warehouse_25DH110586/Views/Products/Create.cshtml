
@{
    ViewBag.Title = "Thêm sản phẩm";
}

<h2>Thêm sản phẩm mới</h2>
<p>Nhập thông tin để thêm sản phẩm vào kho hàng.</p>

<div class="create-card">

    @using (Html.BeginForm("Create", "Products", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Tên sản phẩm</label>

            <input type="text"
                   name="ProductName"
                   class="form-control"
                   value="@Request.Form["ProductName"]"
                   placeholder="Nhập tên sản phẩm" />

            @Html.ValidationMessage(
                "ProductName", "",
                new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Danh mục</label>

            <input type="text"
                   name="Category"
                   class="form-control"
                   value="@Request.Form["Category"]"
                   placeholder="Nhập danh mục" />

            @Html.ValidationMessage(
                "Category", "",
                new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Đơn giá (VNĐ)</label>

            <input type="number"
                   name="Price"
                   step="0.01"
                   class="form-control"
                   value="@Request.Form["Price"]"
                   placeholder="Ví dụ: 500000" />

            @Html.ValidationMessage(
                "Price", "",
                new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Số lượng tồn kho</label>

            <input type="number"
                   name="Quantity"
                   step="1"
                   class="form-control"
                   value="@Request.Form["Quantity"]"
                   placeholder="Ví dụ: 3" />

            @Html.ValidationMessage(
                "Quantity", "",
                new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-primary">
            Thêm sản phẩm
        </button>

        @Html.ActionLink(
            "Quay lại danh sách",
            "Index", "Products", null,
            new { @class = "btn btn-default" })
    }

</div>
